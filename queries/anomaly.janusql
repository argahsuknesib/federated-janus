PREFIX ex: <https://example.org/>

REGISTER RStream ex:anomalies AS
SELECT ?sensor ?current (AVG(?historical) AS ?historicalAverage)
FROM NAMED WINDOW ex:live ON STREAM ex:live-sensors [RANGE 60 STEP 30]
FROM NAMED WINDOW ex:history ON LOG ex:historical-sensors [OFFSET 2592060 RANGE 2592000 STEP 30]
WHERE {
  WINDOW ex:live {
    ?sensor ex:value ?current .
  }
  WINDOW ex:history {
    ?sensor ex:value ?historical .
  }
}
GROUP BY ?sensor ?current
HAVING (?current > 1.3 * AVG(?historical))
