DEFINE BASELINE ex:avg1 ON WINDOW ex:history1 AS
SELECT ?sensor (AVG(?historical) AS ?historicalAverage)
WHERE { ?sensor ex:value ?historical . }
GROUP BY ?sensor

DEFINE BASELINE ex:avg2 ON WINDOW ex:history2 AS
SELECT ?sensor (AVG(?historical) AS ?historicalAverage)
WHERE { ?sensor ex:value ?historical . }
GROUP BY ?sensor

DEFINE BASELINE ex:avg3 ON WINDOW ex:history3 AS
SELECT ?sensor (AVG(?historical) AS ?historicalAverage)
WHERE { ?sensor ex:value ?historical . }
GROUP BY ?sensor

DEFINE BASELINE ex:avg4 ON WINDOW ex:history4 AS
SELECT ?sensor (AVG(?historical) AS ?historicalAverage)
WHERE { ?sensor ex:value ?historical . }
GROUP BY ?sensor

