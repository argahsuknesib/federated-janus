WHERE {
  {
    WINDOW ex:live1 {
      ?sensor ex:value ?current .
    }
    WINDOW ex:history1 {
      ?sensor ex:value ?historical .
    }
    GRAPH <https://example.org/metadata> {
      ?sensor ex:locatedIn ex:RoomA .
    }
  }
  UNION
  {
    WINDOW ex:live2 {
      ?sensor ex:value ?current .
    }
    WINDOW ex:history2 {
      ?sensor ex:value ?historical .
    }
    GRAPH <https://example.org/metadata> {
      ?sensor ex:locatedIn ex:RoomA .
    }
  }
  UNION
  {
    WINDOW ex:live3 {
      ?sensor ex:value ?current .
