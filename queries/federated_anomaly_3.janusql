PREFIX ex: <https://example.org/>

REGISTER RStream ex:anomalies AS
SELECT ?sensor ?current (AVG(?historical) AS ?historicalAverage)
FROM NAMED WINDOW ex:live1 ON STREAM <https://example.org/sensors/1/live> [RANGE 60 STEP 30]
FROM NAMED WINDOW ex:history1 ON LOG <https://example.org/sensors/1/history> [OFFSET 2592060 RANGE 2592000 STEP 30]
FROM NAMED WINDOW ex:live2 ON STREAM <https://example.org/sensors/2/live> [RANGE 60 STEP 30]
FROM NAMED WINDOW ex:history2 ON LOG <https://example.org/sensors/2/history> [OFFSET 2592060 RANGE 2592000 STEP 30]
FROM NAMED WINDOW ex:live3 ON STREAM <https://example.org/sensors/3/live> [RANGE 60 STEP 30]
FROM NAMED WINDOW ex:history3 ON LOG <https://example.org/sensors/3/history> [OFFSET 2592060 RANGE 2592000 STEP 30]
WHERE {
  {
    WINDOW ex:live1 {
      ?sensor ex:value ?current .
    }
    WINDOW ex:history1 {
      ?sensor ex:value ?historical .
    }
  }
  UNION
  {
    WINDOW ex:live2 {
      ?sensor ex:value ?current .
    }
    WINDOW ex:history2 {
      ?sensor ex:value ?historical .
    }
  }
  UNION
  {
    WINDOW ex:live3 {
      ?sensor ex:value ?current .
    }
    WINDOW ex:history3 {
      ?sensor ex:value ?historical .
    }
  }
}
GROUP BY ?sensor ?current
HAVING (?current > 1.3 * AVG(?historical))
